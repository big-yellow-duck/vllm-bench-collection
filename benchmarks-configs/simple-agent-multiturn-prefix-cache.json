{
  "metadata": {
    "labels": {
      "workload": "simple-agent-multiturn-prefix-cache"
    }
  },
  "spec": {
    "backend": {
      "kind": "openai_http",
      "target": "http://localhost:8000",
      "request_format": "/v1/chat/completions",
      "stream": true
    },
    "profile": {
      "kind": "concurrent",
      "streams": [
        1,
        2,
        4,
        8
      ],
      "rampup_duration": 0
    },
    "constraints": [
      {
        "kind": "max_requests",
        "count": [
          8,
          16,
          32,
          64
        ]
      }
    ],
    "data": [
      {
        "kind": "synthetic_text",
        "turns": 8,
        "prompt_tokens": 2048,
        "output_tokens": 512
      }
    ],
    "seed": {
      "kind": "static",
      "value": 20260715
    },
    "outputs": [
      {
        "kind": "json",
        "path": "agent-multiturn-benchmarks.json"
      }
    ],
    "metrics": {
      "kind": "generative",
      "sample_size": 0
    }
  }
}